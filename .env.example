# Sarvam AI (speech-to-text, translation, and chat completion for summaries)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# LLM used for complaint summary generation. Sarvam's own chat completion API
# is used by default, so LLM_API_KEY can be left blank to reuse SARVAM_API_KEY,
# or set separately if you point LLM_MODEL at a different provider later.
LLM_API_KEY=
LLM_MODEL=sarvam-105b
# sarvam-105b is a reasoning model and needs headroom for internal reasoning tokens
# before it emits the final summary; too low a value returns an empty response.
# See docs/AI_AGENT.md for why 4096 (not a smaller "should be enough" number) is the
# value that's actually been reliable in testing.
LLM_MAX_TOKENS=4096

# File storage
UPLOAD_FOLDER=uploads

# Database
DATABASE_URL=sqlite:///./janmitra.db

# Base URL the Streamlit frontends use to reach the FastAPI backend
BACKEND_URL=http://localhost:8000

# Comma-separated origins allowed to call the API from a browser (React dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# General deployment flag -- leave unset ("development") for local dev. A real deployment must
# set ENVIRONMENT=production AND a real JWT_SECRET_KEY below, or the backend refuses to start
# (see backend/main.py's _check_production_secrets()) -- see docs/DEPLOYMENT_GCP.md.
ENVIRONMENT=

# Auth
# Secret used to sign access tokens. Set a long random value in any real deployment (required
# when ENVIRONMENT=production, see above) -- if left blank in local dev, a random key is
# generated at startup, which invalidates all sessions on every restart.
JWT_SECRET_KEY=
# Access tokens are short-lived by design -- a refresh token (below) silently renews them, so
# this only bounds how long a stolen/leaked access token stays useful, not the citizen's actual
# session length.
JWT_EXPIRE_MINUTES=30
# Refresh tokens are long-lived (a citizen shouldn't have to re-login every 30 minutes) but
# rotate on every use and are fully revocable server-side (see backend/models.py's RefreshToken
# and backend/services/auth_service.py's rotate_refresh_token) -- see that combination is what
# makes a month-long lifetime here an acceptable tradeoff.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limiting (see backend/services/rate_limiter.py, backend/middleware.py,
# docs/RATE_LIMITING.md). Defaults below are generous enough for normal use (a real login, a busy
# dashboard page load, or a several-turn Ask Sarthi conversation) while still catching a
# rapid-fire abuse script. In-process only -- see rate_limiter.py's docstring for why (this
# deployment runs a single backend process, so this is correct as-is).
# General baseline -- applied to every route except /health.
GENERAL_RATE_LIMIT=60
GENERAL_RATE_LIMIT_WINDOW_SECONDS=60
# Stricter, purpose-specific limits layered on top of the general one, for the two endpoint
# groups a security audit flagged as highest-risk: login (brute-force) and Ask Sarthi (expensive
# Sarvam/LLM/vision calls).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Signup gets its own, per-hour (not per-minute) limit -- mass fake-account creation is a real,
# distinct abuse pattern a real login rarely triggers. 50, not a tight number like login's 5:
# needs headroom for legitimate shared-IP bursts (a school/office network, a NAT'd mobile
# carrier) without opening the door to true bulk-account-creation abuse.
SIGNUP_RATE_LIMIT=50
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
AI_RATE_LIMIT=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Leave false for local dev (no reverse proxy in front, so the raw TCP connection IS the real
# client). docker-compose.prod.yml sets this true itself, since that deployment's backend
# container is only ever reachable through Caddy -- see config.py's own docstring on this setting.
TRUST_PROXY_HEADERS=false

# LangSmith observability (see docs/ask_janmitra_langsmith_observability.md). Purely an
# observability layer around the existing LangGraph/Ask Sarthi pipeline — leave
# LANGSMITH_TRACING unset/false (the default) to run with no LangSmith dependency at all; the
# app behaves identically either way. Tracing only actually runs when BOTH LANGSMITH_TRACING=true
# AND LANGSMITH_API_KEY are set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=jansarthi-ai
# Optional — enables the Admin dashboard's "View Trace" link. Copy the URL prefix of any trace
# from your own LangSmith project and replace the run/trace id in it with the literal placeholder
# "{trace_id}", e.g.:
#   LANGSMITH_TRACE_URL_TEMPLATE=https://smith.langchain.com/o/<your-org-id>/projects/p/<project>/r/{trace_id}
LANGSMITH_TRACE_URL_TEMPLATE=
# Name of the LangSmith Annotation Queue every "insufficient knowledge" / out-of-scope Ask
# Sarthi trace is routed into for human review (a knowledge-base-gap backlog). Created
# automatically on first use if it doesn't already exist.
LANGSMITH_REVIEW_QUEUE_NAME=jansarthi-ai-knowledge-gaps

# Error monitoring (see backend/main.py's init_error_monitoring(), docs/ERROR_MONITORING.md).
# Leave SENTRY_DSN unset (the default) to run with no Sentry dependency at all; the app behaves
# identically either way. Once set, every unhandled backend exception is automatically reported
# to your Sentry project in real time -- get a DSN by creating a free project at sentry.io (or
# your self-hosted instance) and copying its "DSN" value from Project Settings > Client Keys.
SENTRY_DSN=
# Label shown on every event in the Sentry UI -- keeps local/dev errors visibly separate from
# real production ones. Set to "production" in the actual deployment's .env.
SENTRY_ENVIRONMENT=development
# Fraction (0.0-1.0) of requests to also capture full performance traces for. 0 (the default)
# still reports every error -- this only adds performance/tracing data on top, at a real
# per-request cost, so it's off unless you specifically want that.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Forwards this app's existing logging.* calls to Sentry's Logs product too -- no new logging
# calls needed anywhere, it rides the logging already in the codebase.
SENTRY_ENABLE_LOGS=false
# Enables a small set of business metrics already wired into the code (complaint creation, Ask
# Sarthi request volume, rate-limit trips) -- see docs/ERROR_MONITORING.md for the exact list.
SENTRY_ENABLE_METRICS=false
# Fraction of trace sessions to also code-profile. Only has any effect when
# SENTRY_TRACES_SAMPLE_RATE > 0 too -- see backend/config.py's own docstring on this coupling.
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0

# --- Production deployment only (docker-compose.prod.yml) -- see docs/DEPLOYMENT.md ---
# Domain to serve over, once one points at the VM -- switches Caddy to automatic HTTPS.
# Leave unset to serve plain HTTP on the VM's IP.
SITE_ADDRESS=
# Which built images docker-compose.prod.yml runs. Left unset for a local `--build`; the CD
# workflow (.github/workflows/cd.yml) fills these in with the freshly-pushed GHCR image on
# every deploy.
BACKEND_IMAGE=
FRONTEND_IMAGE=
