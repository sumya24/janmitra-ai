# Sarvam AI (speech-to-text, translation, and chat completion for summaries)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# LLM used for complaint summary generation. Sarvam's own chat completion API
# is used by default, so LLM_API_KEY can be left blank to reuse SARVAM_API_KEY,
# or set separately if you point LLM_MODEL at a different provider later.
LLM_API_KEY=
LLM_MODEL=sarvam-105b
# sarvam-105b is a reasoning model and needs headroom for internal reasoning tokens
# before it emits the final summary; too low a value returns an empty response.
# See docs/AI_AGENT.md for why 4096 (not a smaller "should be enough" number) is the
# value that's actually been reliable in testing.
LLM_MAX_TOKENS=4096

# File storage
UPLOAD_FOLDER=uploads

# Database
DATABASE_URL=sqlite:///./janmitra.db

# Base URL the Streamlit frontends use to reach the FastAPI backend
BACKEND_URL=http://localhost:8000

# Comma-separated origins allowed to call the API from a browser (React dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
# Secret used to sign login tokens. Set a long random value in any real deployment —
# if left blank a random key is generated at startup, which invalidates all sessions
# on every restart.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# LangSmith observability (see docs/ask_janmitra_langsmith_observability.md). Purely an
# observability layer around the existing LangGraph/Ask Sarthi pipeline — leave
# LANGSMITH_TRACING unset/false (the default) to run with no LangSmith dependency at all; the
# app behaves identically either way. Tracing only actually runs when BOTH LANGSMITH_TRACING=true
# AND LANGSMITH_API_KEY are set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=jansarthi-ai
# Optional — enables the Admin dashboard's "View Trace" link. Copy the URL prefix of any trace
# from your own LangSmith project and replace the run/trace id in it with the literal placeholder
# "{trace_id}", e.g.:
#   LANGSMITH_TRACE_URL_TEMPLATE=https://smith.langchain.com/o/<your-org-id>/projects/p/<project>/r/{trace_id}
LANGSMITH_TRACE_URL_TEMPLATE=
# Name of the LangSmith Annotation Queue every "insufficient knowledge" / out-of-scope Ask
# Sarthi trace is routed into for human review (a knowledge-base-gap backlog). Created
# automatically on first use if it doesn't already exist.
LANGSMITH_REVIEW_QUEUE_NAME=jansarthi-ai-knowledge-gaps

# --- Production deployment only (docker-compose.prod.yml) -- see docs/DEPLOYMENT.md ---
# Domain to serve over, once one points at the VM -- switches Caddy to automatic HTTPS.
# Leave unset to serve plain HTTP on the VM's IP.
SITE_ADDRESS=
# Which built images docker-compose.prod.yml runs. Left unset for a local `--build`; the CD
# workflow (.github/workflows/cd.yml) fills these in with the freshly-pushed GHCR image on
# every deploy.
BACKEND_IMAGE=
FRONTEND_IMAGE=
